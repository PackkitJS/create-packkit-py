  "src/fixture/__main__.py": """"Command-line entry point for fixture."""

import argparse

from fixture import greet


def main() -> None:
    parser = argparse.ArgumentParser(prog="fixture", description="A fixture project.")
    parser.add_argument("name", nargs="?", default="world", help="who to greet")
    args = parser.parse_args()
    print(greet(args.name))


if __name__ == "__main__":
    main()
",
  "src/fixture/py.typed": "",
  "tests/test_fixture.py": "import sys

import pytest

from fixture import greet
from fixture.__main__ import main


def test_greet() -> None:
    assert greet("world") == "Hello, world!"


def test_main_greets(capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(sys, "argv", ["fixture", "there"])
    main()
    assert "Hello, there!" in capsys.readouterr().out
",
}
`;

